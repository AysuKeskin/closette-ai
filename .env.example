# ============================================================
# Closette AI — environment variables (copy to .env)
# ============================================================

# ---- Postgres ----
POSTGRES_DB=closette
POSTGRES_USER=closette
POSTGRES_PASSWORD=closette

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=closette
MINIO_ROOT_PASSWORD=closette123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_WARDROBE=wardrobe
MINIO_BUCKET_BEAUTY=beauty

# ---- Backend (Spring Boot) ----
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long-000000
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
# Base URL of the FastAPI AI service, as seen from the backend
AI_SERVICE_BASE_URL=http://localhost:8000

# ---- AI service (FastAPI) ----
# VLM = used ONLY for attributes / OCR / reasoning (a model is truly needed).
# All non-mock providers are OpenAI-compatible (one client covers them all):
#   openai | openrouter | dashscope (Qwen) | qwen | moonshot (Kimi) | kimi
AI_PROVIDER=mock
AI_SERVICE_PORT=8000
# Simplest: set ONE generic key (+ optionally pin the model). Get a key from:
#   OpenAI     → https://platform.openai.com/api-keys
#   OpenRouter → https://openrouter.ai/keys   (one key, many models incl. Qwen-VL)
#   DashScope  → https://dashscope.console.aliyun.com   (official Qwen)
#   Moonshot   → https://platform.moonshot.ai   (Kimi)
# VLM_API_KEY=
# VLM_MODEL=              # e.g. gpt-4o-mini | qwen/qwen-2.5-vl-72b-instruct | qwen-vl-max
# VLM_BASE_URL=           # override the provider's default endpoint if needed
# VLM_FALLBACK_TO_MOCK=true   # on any VLM error, degrade to mock instead of failing
# Provider-specific keys also work: OPENAI_API_KEY / QWEN_API_KEY / KIMI_API_KEY

# Classic-tool layers (default: no model / no GPU). Colour, normalisation and
# scoring are pure code and have NO provider setting.
SEG_PROVIDER=none         # none (passthrough) | birefnet   (background removal)
EMBED_PROVIDER=mock       # mock | fashionsiglip            (fashion similarity)

# Optional: route only low-confidence VLM results to a paid model.
# VLM_FALLBACK_PROVIDER=  # e.g. openai | kimi   (off by default)
# VLM_CONFIDENCE_THRESHOLD=0.45

# ---- Email (verification + password reset) ----
# log = dev (codes printed to the backend console) | resend = real email.
# Resend free tier: 3,000 emails/mo; test without your own domain via
# onboarding@resend.dev. Get a key at https://resend.com/api-keys
# Docker/production reads these three from this file. Running the backend with
# ./gradlew bootRun instead reads backend/.env (git-ignored), so set them there
# for local work.
EMAIL_PROVIDER=log
# RESEND_API_KEY=re_...
# On the free tier onboarding@resend.dev only delivers to your own Resend account
# address. Sending to anyone else needs a domain verified at resend.com/domains.
# EMAIL_FROM=Closette <onboarding@resend.dev>

# ---- Beauty product search (optional) ----
# Two free sources always run: the Makeup API and Open Beauty Facts. Open Beauty
# Facts carries only ~950 products sold in Turkey, so a paid catalogue is the main
# lever on search quality for Turkish shelves.
# A RapidAPI listing is used when a key is set. Which endpoint it exposes differs
# per listing, so both the path and the query parameter are configurable:
#   apidojo "Sephora"        -> /products/list      with q=
#   "Real-Time Sephora API"  -> /search-by-keyword  with query=
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=sephora.p.rapidapi.com
# RAPIDAPI_SEARCH_PATH=/products/list
# RAPIDAPI_QUERY_PARAM=q

# ---- Mobile (Expo) ----
# Base URL of the backend as seen from the device/simulator.
# iOS simulator: http://localhost:8080 ; Android emulator: http://10.0.2.2:8080
# Physical device: http://<your-LAN-ip>:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Public photo links must resolve from the phone, independently of MINIO_ENDPOINT.
# For a physical phone, use the host's LAN address in local development.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
RATE_LIMIT_MODE=enforce
# Keep all Compose ports on localhost by default; production uses compose.production.yml.
# Legal pages are hosted at PUBLIC_BASE_URL/privacy and PUBLIC_BASE_URL/support.
PUBLIC_BASE_URL=http://localhost:8080
PRIVACY_OPERATOR="Closette (development)"
SUPPORT_EMAIL=
AI_PRIVACY_URL=
AI_PROCESSING_DETAILS="Local development mock; no external AI transfer."
INFRASTRUCTURE_DETAILS="Local development storage."
BACKUP_RETENTION_DAYS=30
# EAS production environment (public build metadata, never API secrets):
# IOS_BUNDLE_IDENTIFIER=
# EAS_PROJECT_ID=
